# ====================================================================
# SolarCAD - Configuração de Ambiente & Conexões
# ====================================================================
# Você pode configurar estas variáveis no arquivo .env OU diretamente
# na interface da aplicação clicando em "Conexão & IA" no menu lateral.

# 1. Supabase (Banco de Dados & Autenticação)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# 2. Provedor de IA (Opcional - OCR de Faturas e Otimização de Strings)
# Provedores suportados: Google Gemini, Groq, OpenAI, OpenRouter
VITE_AI_PROVIDER=gemini
VITE_AI_API_KEY=your-gemini-or-openai-api-key
